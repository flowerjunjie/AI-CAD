# AI-CAD 环境配置模板
# 复制为 .env 并填入真实密钥: cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# ─── LLM 提供商 (Agnes AI - 主) ───────────────────────────────
AI_CAD_LLM_PROVIDER=agnes
AGNES_API_KEY=填入你的Agnes密钥
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# ─── 备用 LLM 提供商 (可选) ───────────────────────────────────
MINIMAX_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=

# ─── 服务配置 ──────────────────────────────────────────────────
SERVER_PORT=3456
LOG_LEVEL=info
