# 各专业 e2e 测试的可运行 fixture (由 data/sample/make_*_sample_dxf.py 生成,
# 断言依赖 os.path.isfile), 放行 — 其余 dxf 出图产物仍忽略
!data/sample/*_sample.dxf
*.sqlite3

# Electron
*.asar

# Temp files
*.tmp
*.temp
*.spec
background-info/

# 规则 DSL 写回备份 (bridge.py /api/rules/dsl/apply 生成, 供回滚, 不追踪)
src/rules/rules/default.json.bak.*

# 求职/面试类文档不纳入版本管理（按内容关键词匹配，文件名不含"面试"也拦得住）
doc/*面试*.md
doc/*求职*.md
doc/*口袋卡*.md
doc/*词汇速查*.md

# coverage 工具产物 (coverage run 生成, 非源码)
.coverage

# M5 协同运行态数据 (bridge /api/collab/* 写锁演示产生, 非源码, 不追踪)
data/collab/
